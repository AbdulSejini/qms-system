# Local Firebase emulator - محاكي Firebase المحلي
#
# Used with:  npm run dev:emulator
#
# The Firebase config below is INTENTIONALLY fake. The emulator never authenticates
# against Google, so no real project id, key or account is involved - pointing this file
# at the live project would only risk a stray write escaping to it.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099

NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-qms.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-qms
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-qms.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
