{
  "_comment": [
    "Copy this file to .firebaserc and replace <projectId> with the value of",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID in .env.local, or let the CLI write it for",
    "you with: firebase use --add",
    "Without a .firebaserc (or an explicit --project <projectId>) the command",
    "'firebase deploy --only firestore:rules' fails with 'No currently active",
    "project'. firebase-tools must be installed: npm install -g firebase-tools",
    "Remove this _comment key from the real .firebaserc."
  ],
  "projects": {
    "default": "<projectId>"
  }
}
