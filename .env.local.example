# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# System Admin Account
# The system admin document is created on first run WITHOUT a password - nothing is
# seeded, because this code runs in the browser and any seeded value would be public.
# Instead, the login screen shows a one-time administrator setup panel while no password
# exists, and the password is chosen there. Whoever reaches that screen first sets it,
# so open the app yourself before sharing the URL. Once set, the panel stays hidden only
# while the password document survives: the current Firestore rules let anyone delete it,
# and the panel then reopens for whoever loads /login next - see SECURITY.md. The password
# can be changed from the Settings page like any other account.
# There is no environment variable for it.

# OneDrive Integration
# Get your Client ID from Azure Active Directory:
# 1. Go to https://portal.azure.com
# 2. Navigate to Azure Active Directory > App registrations
# 3. Create a new app or use existing one
# 4. Copy the Application (client) ID
# 5. IMPORTANT: Add Redirect URI in "Authentication" section:
#    - Click "Add a platform" > "Single-page application"
#    - Add: http://localhost:3000/auth/onedrive (for development)
#    - Add: https://your-domain.com/auth/onedrive (for production)

NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=your-azure-app-client-id-here
